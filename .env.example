# Copy to .env and fill in from Firebase Console → Project settings → Your apps.
# All seven are needed except MEASUREMENT_ID, which is only used for Analytics.
# Without them the app still runs — it just keeps orders on the device.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
