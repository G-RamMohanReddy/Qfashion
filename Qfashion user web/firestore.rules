rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Read this before you ship it to real users. It is written to make the demo
// work today without an auth flow, and it trades security for that:
//
//   * anyone who can find the project can list every order, with the customer
//     name, phone number and delivery address inside it;
//   * anyone can create an order document.
//
// That is acceptable for a portfolio build with invented customers. It is not
// acceptable the day a real person types their real address. The hardened
// version is at the bottom of this file — switch to it before launch.
//
// Do NOT leave Firestore in test mode instead: those rules are equally open AND
// they expire after 30 days, at which point the site silently stops saving.

service cloud.firestore {
  match /databases/{database}/documents {

    // Orders. Created by the storefront; never edited or deleted from the client.
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Customer feedback collected by the Q-Stylist.
    match /feedback/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // "Notify me when available" — the waitlist on out-of-stock items.
    match /notifyRequests/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Live stock levels. The storefront reads these and decrements on purchase.
    match /stock/{productId} {
      allow read, write: if true;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

