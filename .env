# Q Fashion — Firebase web configuration.
#
# These values are PUBLIC by design: Vite inlines them into the JavaScript
# bundle at build time and anyone can read them in devtools. That is normal for
# a Firebase web app — the API key identifies the project, it does not grant
# access. Access is controlled by Firestore security rules (firestore.rules).
#
# This file covers local development only. Vercel does not read it, so the same
# variables must also be added under
#   Vercel → Project → Settings → Environment Variables
# (the "paste .env" box accepts this file's contents as-is). Vite inlines them
# during the build, so redeploy after adding or changing any of them.

VITE_FIREBASE_API_KEY=AIzaSyDxtfrGMGqJP8ZVxflTchikshmQd-gOReQ
VITE_FIREBASE_AUTH_DOMAIN=qfashion-9fafc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qfashion-9fafc
VITE_FIREBASE_STORAGE_BUCKET=qfashion-9fafc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=648576469297
VITE_FIREBASE_APP_ID=1:648576469297:web:6f7c573c9ce2aa1255c810
VITE_FIREBASE_MEASUREMENT_ID=G-D7L9DP72KX
